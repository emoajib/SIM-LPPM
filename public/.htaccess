<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Block access to sensitive files
    RewriteRule ^\.env$ - [F,L]
    RewriteRule ^\.gitignore$ - [F,L]
    RewriteRule ^\.gitattributes$ - [F,L]
    RewriteRule ^\.htaccess$ - [F,L]
    RewriteRule ^composer\.json$ - [F,L]
    RewriteRule ^composer\.lock$ - [F,L]
    RewriteRule ^phpunit\.xml$ - [F,L]
    RewriteRule ^package\.json$ - [F,L]
    RewriteRule ^mix-manifest\.json$ - [F,L]
    RewriteRule ^tsconfig\.json$ - [F,L]
    RewriteRule ^webpack\.mix\.js$ - [F,L]
    RewriteRule ^postcss\.config\.js$ - [F,L]
    RewriteRule ^babel\.config\.js$ - [F,L]
    RewriteRule ^eslint\.config\.js$ - [F,L]
    RewriteRule ^vitest\.config\.js$ - [F,L]
    RewriteRule ^phpstan\.neon$ - [F,L]
    RewriteRule ^pint\.xml$ - [F,L]
    RewriteRule ^test\.xml$ - [F,L]
    RewriteRule ^artisan$ - [F,L]
    RewriteRule ^docker-compose\.yml$ - [F,L]
    RewriteRule ^Dockerfile$ - [F,L]
    RewriteRule ^README\.md$ - [F,L]
    RewriteRule ^CHANGELOG$ - [F,L]
    RewriteRule ^LICENSE$ - [F,L]

    # Block access to sensitive directories
    RewriteRule ^\.git/ - [F,L]
    RewriteRule ^node_modules/ - [F,L]
    RewriteRule ^storage/app/backup/ - [F,L]
    RewriteRule ^storage/logs/ - [F,L]
    RewriteRule ^database/database\.sqlite$ - [F,L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Increase upload limits for large backups (up to 512MB)
<IfModule mod_php7.c>
    php_value upload_max_filesize 512M
    php_value post_max_size 512M
    php_value memory_limit 1024M
    php_value max_execution_time 600
    php_value max_input_time 600
</IfModule>

<IfModule mod_php.c>
    php_value upload_max_filesize 512M
    php_value post_max_size 512M
    php_value memory_limit 1024M
    php_value max_execution_time 600
    php_value max_input_time 600
</IfModule>

